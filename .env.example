# ============================================
# AGENTE AUTÔNOMO WHATSAPP - CONFIGURAÇÕES
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- ANTHROPIC (Claude AI) ---
ANTHROPIC_API_KEY=sua_chave_api_aqui

# Modelo Claude a usar (não altere sem necessidade)
CLAUDE_MODEL=claude-sonnet-4-6

# --- WHATSAPP ---
# ID do grupo dos gestores (formato: XXXXXXXXXXX@g.us)
# Para descobrir o ID: envie uma mensagem no grupo e verifique o log do agente
MANAGERS_GROUP_ID=

# ID do grupo de treinamento (onde você ensina o agente novas skills)
# Crie um grupo só com você (ou com os treinadores) e cole o ID aqui
TRAINING_GROUP_ID=

# Nome que o agente usará ao se apresentar
AGENT_NAME=Assistente Virtual

# --- COMPORTAMENTO DO AGENTE ---
# Confiança mínima para responder sem escalar (0.0 a 1.0)
# Valores menores = agente mais proativo em escalar para gestores
CONFIDENCE_THRESHOLD=0.7

# Máximo de mensagens recentes incluídas no contexto por conversa
MAX_HISTORY_LENGTH=20

# A cada quantas mensagens gerar um resumo da conversa
# O resumo garante que o agente lembre o contexto em conversas longas
SUMMARIZE_AFTER_MESSAGES=15

# Timeout de escalações sem resposta (em milissegundos)
# 3600000 = 1 hora
ESCALATION_TIMEOUT_MS=3600000
