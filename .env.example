# =================================================
# AGENTE AUTÔNOMO WHATSAPP — CONFIGURAÇÕES
# =================================================
# Copie este arquivo para .env e preencha os valores

# --- INTELIGÊNCIA ARTIFICIAL ---
OPENAI_API_KEY=sk-...sua_chave_aqui
# Modelos disponíveis: gpt-4o (recomendado), gpt-4o-mini (econômico)
MODELO_IA=gpt-4o

# --- WHATSAPP ---
# ID do grupo dos gestores (respostas de escalação — formato: 000000@g.us)
ID_GRUPO_GESTORES=

# ID do grupo de treinamento (skills + documentos)
ID_GRUPO_TREINAMENTO=

# Nome do agente
NOME_AGENTE=Assistente Virtual

# --- COMPORTAMENTO DO AGENTE ---
# Confiança mínima para responder sem escalar (0.0 a 1.0)
LIMIAR_CONFIANCA=0.7

# Máximo de mensagens recentes no contexto por conversa
MAX_HISTORICO_MENSAGENS=20

# A cada quantas mensagens gerar resumo automático da conversa
RESUMIR_APOS_MENSAGENS=15

# Tempo para timeout de escalações sem resposta (ms) — padrão: 1 hora
TIMEOUT_ESCALACAO_MS=3600000
